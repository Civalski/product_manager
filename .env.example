# Copie para ".env" na raiz do repositório (ou use backend/ProductStore.Api/.env).
# O último ficheiro carregado prevalece por chave (ver DotEnvBootstrap em Program.cs).

# Documentação Cosmos: https://cosmos.bluesoft.com.br/api

# --- API (local / Render) ---
# Cosmos__Token=

# JWT (autenticação da API). Em produção defina Jwt__Key com pelo menos 32 caracteres secretos.
# Jwt__Key= # pode ser gerada via power shell [Convert]::ToBase64String((1..48 | ForEach-Object { Get-Random -Maximum 256 }))
# Jwt__Issuer=ProductStore
# Jwt__Audience=ProductStore
#
# Cloudflare Turnstile (siteverify) — chave secreta do widget (nunca no front-end).
# Turnstile__SecretKey=
# Chaves de teste: https://developers.cloudflare.com/turnstile/troubleshooting/testing/

# Render (Web Service da API): origem do teu site no Vercel — é o CORS, não a URL da API.
# CORS_ORIGINS=https://seu-dominio.vercel.app

# --- Front (Vite) — NÃO fica neste ficheiro em produção ---
# VITE_API_BASE_URL = URL pública da API (Render), ex.: https://xxx.onrender.com

# Define-se na Vercel: projeto → Settings → Environment Variables → nome VITE_API_BASE_URL
# (ambiente Production; sem barra no fim). Ver também frontend/.env.example
