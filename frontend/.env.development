# Vazio no dev: use o proxy do Vite (vite.config.ts) para /api → evita CORS e redirect HTTPS.
# Se preferir chamar a API diretamente: VITE_API_BASE_URL=http://localhost:5127
VITE_API_BASE_URL=

# Chaves de teste Cloudflare Turnstile (sempre passam). Produção: substituir no painel Cloudflare.
VITE_TURNSTILE_SITE_KEY=1x00000000000000000000AA
